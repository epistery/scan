{
  "port": 3000,
  "mongo": {
    "host": "mongodb://localhost:27017/epistery-scan"
  },
  "chains": {
    "polygon": {
      "enabled": true,
      "rpcUrl": "https://polygon-bor-rpc.publicnode.com"
    },
    "ethereum": {
      "enabled": true,
      "rpcUrl": "https://ethereum-rpc.publicnode.com"
    },
    "japanopenchain": {
      "enabled": true
    }
  },
  "ingestion": {
    "autostart": false,
    "pollInterval": 300000
  },
  "appBaseUrl": "https://epistery.app",
  "appPollInterval": 3600000
}
